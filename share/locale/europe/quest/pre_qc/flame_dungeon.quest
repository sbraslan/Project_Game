quest flame_dungeon begin
	state start begin
		function setting()
			return {
				["bossroom_entry_pos"]					= { 8109, 6867 },
				["dungeon_entry_pos"]					= { 7762, 6739 },
				["outside_entry_pos"]					= { 6142, 7068 },

				-- Dungeon basic configs
				["FLAME_DUNGEON_MAP_INDEX"]				= 	351, 						-- FlameDungeon map_index
				["FLAME_DUNGEON_FINAL_BOSS_POS"]		= 	{ 686, 637 },				-- Coordinates where appear the final boss

				-- Destiny Lock
				["FLAME_DUNGEON_LOCK_VNUM"]				= 20387,
				["FLAME_DUNGEON_LOCK_POS"]				= {
					{ 320, 394 },
					{ 293, 359 },
					{ 333, 321 },
					{ 378, 320 },
					{ 400, 355 },
					{ 394, 401 }
				},
				["FLAME_DUNGEON_LOCK_DIR"]				= { 135, 90, 210, 152, 90, 223 },

				-- Dragon Gate
				["FLAME_DUNGEON_DOOR_VNUM"]				= 20388,
				["FLAME_DUNGEON_DOOR_POS"]				= {
					{ 268, 447 },
					{ 234, 359 },
					{ 300, 264 },
					{ 454, 217 },
					{ 470, 355 },
					{ 467, 469 }
				},
				["FLAME_DUNGEON_DOOR_DIR"]				= { 135, 90, 210, 135, 90, 239 },

				-- Floors settings
				-- 2nd floor
				["FLAME_DUNGEON_2F_ITEM_VNUM"]			= 30329, -- Golden Cog Wheel
				["FLAME_DUNGEON_STELE_POS"]				= { 195, 352 },

				-- 4th floor
				["FLAME_DUNGEON_SEMIBOSS_POS"] 			= { 470, 175 },

				-- 5th floor
				["FLAME_DUNGEON_5F_ITEM_VNUM"]			= 30330, -- Maat Stone
				["LEVEL5_STONE_POS"] = {
					{ 486, 345 },
					{ 511, 336 },
					{ 525, 349 },
					{ 521, 365 },
					{ 503, 372 },
					{ 486, 365 },
					{ 500, 354 }
				},

				-- 6th floor
				["FLAME_DUNGEON_STONE_POS"]				= { 511, 480 },
			}
		end

		function is_flamed(idx)
			return idx >= flame_dungeon.setting().FLAME_DUNGEON_MAP_INDEX * 10000 and idx < (flame_dungeon.setting().FLAME_DUNGEON_MAP_INDEX + 1) * 10000
		end

		function make_dungeon()
			local setting = flame_dungeon.setting()
			d.new_jump_party(setting.FLAME_DUNGEON_MAP_INDEX, setting.dungeon_entry_pos[1], setting.dungeon_entry_pos[2])
			d.regen_file("data/dungeon/flame_dungeon/npc.txt")
			d.setf("level", 0)
			for i = 1, 6 do
				d.set_unique("door" .. i, d.spawn_mob_ac_dir(setting.FLAME_DUNGEON_LOCK_VNUM, setting.FLAME_DUNGEON_LOCK_POS[i][1], setting.FLAME_DUNGEON_LOCK_POS[i][2], setting.FLAME_DUNGEON_LOCK_DIR[i]))
			end
			for i = 1, 6 do
				d.set_unique("idoor" .. i, d.spawn_mob_ac_dir(setting.FLAME_DUNGEON_DOOR_VNUM, setting.FLAME_DUNGEON_DOOR_POS[i][1], setting.FLAME_DUNGEON_DOOR_POS[i][2], setting.FLAME_DUNGEON_DOOR_DIR[i]))
			end
			d.setf("clear_count", 0)
			d.setf("flame_started", 0)
			d.setf("dungeon_enter", 0)
		end

		function main_quest_complete()
			if 0 > 0 then
				local main_quest = pc.getf("main_quest_flame_lv103", "__status")
				if main_quest != nil and main_quest == main_quest_flame_lv103.__COMPLETE__ then
					return true
				end

				return false
			end

			return true
		end

		function go_boss()
			local setting = flame_dungeon.setting()
			if pc.get_level() < 104 then
				say(locale_quest(1374))
				return
			else
				if flame_dungeon.main_quest_complete() then
					say(locale_quest(1317))
					local warp = select(locale_quest(1318), locale_quest(1319))
					if warp == 1 then
						d.setf("level", 17)
						d.jump_all(setting.bossroom_entry_pos[1], setting.bossroom_entry_pos[2])
						d.set_regen_file("data/dungeon/flame_dungeon/fd_fild_boss.txt")
						d.spawn_mob(6091, setting.FLAME_DUNGEON_FINAL_BOSS_POS[1], setting.FLAME_DUNGEON_FINAL_BOSS_POS[2])
					end
				else
					say(locale_quest(1320))
					return
				end
			end
		end

		function level_clear()
			d.setf("level", 0)
			d.clear_regen()
			d.purge_area(750000, 620000, 817400, 689400)
		end

		function clear_timer(inx)
			clear_server_timer("flame_dungeon_0m_left_timer", inx)
			clear_server_timer("flame_dungeon_1m_left_timer", inx)
			clear_server_timer("flame_dungeon_5m_left_timer", inx)
			clear_server_timer("flame_dungeon_10m_left_timer", inx)
			clear_server_timer("flame_dungeon_15m_left_timer", inx)
			clear_server_timer("flame_dungeon_30m_left_timer", inx)
			clear_server_timer("flame_dungeon_45m_left_timer", inx)
			clear_server_timer("flame_count_monster", inx)
			clear_server_timer("killed_A_2", inx)
			clear_server_timer("flame_dungeon_ticket_remove", inx)
		end

		when login begin
			local idx = pc.get_map_index()
			local setting = flame_dungeon.setting()
			if idx == setting.FLAME_DUNGEON_MAP_INDEX then
				pc.warp(setting.outside_entry_pos[1] * 100, setting.outside_entry_pos[2] * 100, 62)
			elseif flame_dungeon.is_flamed(idx) then
				--pc.set_warp_location(0, 0 , 0)
				pc.set_warp_location(62, setting.outside_entry_pos[1], setting.outside_entry_pos[2])
				local ticketGroup = { get_special_item_group(10033) }
				if d.getf("dungeon_enter") == 0 then
					local canPass = false
					for i = 1, table.getn(ticketGroup), 2 do
						if pc.count_item(ticketGroup[i]) >= ticketGroup[i + 1] then
							canPass = true
							break
						end
					end

					if get_global_time() - pc.getf("flame_dungeon", "exit_time") < 30 * 60 then
						d.notice(locale_quest(1321))
						say(locale_quest(1322))
						timer("flame_dungeon_warp_timer", 5)
					elseif not canPass then
						d.notice(locale_quest(1323))
						say(locale_quest(1324))
						timer("flame_dungeon_warp_timer", 5)
					elseif pc.get_level() < 100 then
						d.notice(locale_quest(1325))
						say(locale_quest(1326))
						timer("flame_dungeon_warp_timer", 5)
					end
				elseif pc.getf("flame_dungeon", "ticket_delete") == 0 then
					for i = 1, table.getn(ticketGroup), 2 do
						if pc.count_item(ticketGroup[i]) >= ticketGroup[i + 1] then
							pc.remove_item(ticketGroup[i], ticketGroup[i + 1])
							break
						end
					end
					pc.setf("flame_dungeon", "ticket_delete", 1)
				end
			else
				pc.setf("flame_dungeon", "ticket_delete", 0)
			end
		end

		when flame_dungeon_warp_timer.timer begin
			local setting = flame_dungeon.setting()
			pc.warp(setting.outside_entry_pos[1] * 100, setting.outside_entry_pos[2] * 100, 62)
		end

		when logout begin
			local idx = pc.get_map_index()
			if flame_dungeon.is_flamed(idx) then
				if d.getf("dungeon_enter") == 1 then
					pc.setf("flame_dungeon", "exit_time", get_global_time())
				end
			end
		end

		when 20394.chat.locale_quest(1327) begin
			local setting = flame_dungeon.setting()
			if party.is_party() then
				local party_check = 0
				if d.find(party.getf("dungeon_index")) then
					party_check = (d.getf_from_map_index("party_leader_pid", party.getf("dungeon_index")) == party.get_leader_pid())
				end

				if d.find(party.getf("dungeon_index")) and party_check then
					if get_global_time() - pc.getf("flame_dungeon", "exit_time") < 5 * 60 then
						local dungeon_level = d.getf_from_map_index("level", party.getf("dungeon_index"))
						if dungeon_level == 17 then
							pc.warp(setting.bossroom_entry_pos[1] * 100, setting.bossroom_entry_pos[2] * 100, party.getf("dungeon_index"))
						else
							pc.warp(setting.dungeon_entry_pos[1] * 100, setting.dungeon_entry_pos[2] * 100, party.getf("dungeon_index"))
						end
					else
						say_title(mob_name(20394))
						say(locale_quest(1375))
					end
				else
					local pids = { party.get_member_pids() }
					local noTicketMembers = {}
					local notEnoughLevelMembers = {}
					local ticketCheck = true
					local levelCheck = true
					local ticketGroup = { get_special_item_group(10033) }
					for i, pid in next, pids, nil do
						q.begin_other_pc_block(pid)
						local canPass = false
						for idx = 1, table.getn(ticketGroup), 2 do
							if pc.count_item(ticketGroup[idx]) >= ticketGroup[idx + 1] then
								canPass = true
								break
							end
						end

						if not canPass then
							table.insert(noTicketMembers, pc.get_name())
							ticketCheck = false
						end

						if pc.get_level() < 100 then
							table.insert(notEnoughLevelMembers, pc.get_name())
							levelCheck = false
						end

						q.end_other_pc_block()
					end

					if not ticketCheck then
						say_title(mob_name(20394))
						say(locale_quest(1377))
						for i, name in next, noTicketMembers, nil do
							say(color(1, 1, 0), locale_quest(1378) .. name)
						end
						if levelCheck then
							return
						else
							wait()
						end
					end

					if not levelCheck then
						say_title(mob_name(20394))
						say(locale_quest(1379))
						for i, name in next, notEnoughLevelMembers, nil do
							say(color(1,1,0), locale_quest(1378) .. name)
						end
						return
					end

					if party.is_leader() then
						say(locale_quest(1328))
						local warp = select(locale_quest(1329), locale_quest(1330))
						if warp == 1 then
							if party.is_map_member_flag_lt("exit_time", get_global_time() - 30 * 60) then
								flame_dungeon.make_dungeon()
							else
								say(locale_quest(1376))
							end
						end
						party.setf("flame_dungeon_boss_kill_count", 0)
					else
						say(locale_quest(1331))
					end
				end
			else
				say(locale_quest(1332))
			end
		end

		when flame_dungeon_45m_left_timer.server_timer begin
			if d.select(get_server_timer_arg()) then
				d.notice(locale_quest(1334, 45))
				d.notice(locale_quest(1333))
				server_timer("flame_dungeon_30m_left_timer", 15 * 60, get_server_timer_arg())
			end
		end

		when flame_dungeon_30m_left_timer.server_timer begin
			if d.select(get_server_timer_arg()) then
				d.notice(locale_quest(1334, 30))
				d.notice(locale_quest(1333))
				server_timer("flame_dungeon_15m_left_timer", 15 * 60, get_server_timer_arg())
			end
		end

		when flame_dungeon_15m_left_timer.server_timer begin
			if d.select(get_server_timer_arg()) then
				d.notice(locale_quest(1334, 15))
				d.notice(locale_quest(1333))
				server_timer("flame_dungeon_5m_left_timer", 10 * 60, get_server_timer_arg())
			end
		end

		when flame_dungeon_5m_left_timer.server_timer begin
			if d.select(get_server_timer_arg()) then
				d.notice(locale_quest(1334, 5))
				d.notice(locale_quest(1333))
				server_timer("flame_dungeon_1m_left_timer", 4 * 60, get_server_timer_arg())
			end
		end

		when flame_dungeon_1m_left_timer.server_timer begin
			if d.select(get_server_timer_arg()) then
				d.notice(locale_quest(1334, 1))
				d.notice(locale_quest(1333))
				server_timer("flame_dungeon_0m_left_timer", 60, get_server_timer_arg())
			end
		end

		when flame_dungeon_0m_left_timer.server_timer begin
			local setting = flame_dungeon.setting()
			if d.select(get_server_timer_arg()) then
				d.notice(locale_quest(1335))
				d.notice(locale_quest(1336))
				server_timer("dungeon_end_timer", 10, d.get_map_index())
			end
		end

		when 20385.chat.locale_quest(1337) with npc.lock() begin
			local setting = flame_dungeon.setting()
			if d.getf("flame_started") == 0 then
				say(locale_quest(1339))
				say(locale_quest(1340))
				wait()
				d.setf("flame_started", 1)
				server_timer("flame_dungeon_45m_left_timer", 15 * 60, d.get_map_index())
				d.notice(locale_quest(1341))
				d.notice(locale_quest(1333))

				local pids = { party.get_member_pids() }
				local ticketGroup = { get_special_item_group(10033) }
				for i, pid in next, pids, nil do
					q.begin_other_pc_block(pid)
					local canPass = false
					for idx = 1, table.getn(ticketGroup), 2 do
						if pc.count_item(ticketGroup[idx]) >= ticketGroup[idx + 1] then
							canPass = true
							pc.remove_item(ticketGroup[idx], ticketGroup[idx + 1])
							break
						end
					end

					if not canPass then
						pc.warp(setting.outside_entry_pos[1] * 100, setting.outside_entry_pos[2] * 100, 62)
					end

					q.end_other_pc_block()
				end

				d.setqf2("flame_dungeon", "ticket_delete", 1)
				d.setf("dungeon_enter", 1)
				party.setf("dungeon_index", d.get_map_index())
				d.setf("party_leader_pid", party.get_leader_pid())
			end

			if d.getf("level") < 7 then
				if d.getf("clear_count") == 6 then
					d.setf("level", 7)
				else
					local rand = number(1, 6)
					local setlev = 0
					d.setf("level", 7)
					for i = 1, 50 do
						setlev = setlev + 1
						if setlev > 6 then
							setlev = 1
						end
						if not d.is_unique_dead("door" .. setlev) then
							rand = rand - 1
							if rand == 0 then
								d.setf("level", setlev)
								d.setf("clear_count", d.getf("clear_count") + 1)
								break
							end
						end
					end
				end
			end

			if d.getf("level") == 1 then
				say(locale_quest(1342))
				d.notice(locale_quest(1342))
				d.kill_unique("door1")
				d.kill_unique("idoor1")
				d.setf("level", 11)
				d.regen_file("data/dungeon/flame_dungeon/fd_a.txt")
				server_timer("flame_count_monster", 12, d.get_map_index())
			elseif d.getf("level") == 11 then
				say(locale_quest(1343))
				say_title(locale_quest(1344, d.count_monster()))
			elseif d.getf("level") == 2 then
				say(locale_quest(1345))
				say(locale_quest(1346))
				d.notice(locale_quest(1345))
				--d.notice(locale_quest(1346))
				d.spawn_mob(20386, setting.FLAME_DUNGEON_STELE_POS[1], setting.FLAME_DUNGEON_STELE_POS[2])
				d.kill_unique("door2")
				d.kill_unique("idoor2")
				d.set_regen_file("data/dungeon/flame_dungeon/fd_b.txt")
				d.setf("level", 12)
			elseif d.getf("level") == 12 then
				say(locale_quest(1347))
			elseif d.getf("level") == 3 then
				say(locale_quest(1342))
				d.notice(locale_quest(1342))
				d.kill_unique("door3")
				d.kill_unique("idoor3")
				d.setf("level", 13)
				d.regen_file("data/dungeon/flame_dungeon/fd_c.txt")
				server_timer("flame_count_monster", 12, d.get_map_index())
			elseif d.getf("level") == 13 then
				say(locale_quest(1343))
				say_title(locale_quest(1344, d.count_monster()))
			elseif d.getf("level") == 4 then
				say(locale_quest(1348))
				d.notice(locale_quest(1348))
				d.setf("level", 14)
				d.kill_unique("door4")
				d.kill_unique("idoor4")
				d.set_regen_file("data/dungeon/flame_dungeon/fd_d.txt")
				d.spawn_mob(6051, setting.FLAME_DUNGEON_SEMIBOSS_POS[1], setting.FLAME_DUNGEON_SEMIBOSS_POS[2])
			elseif d.getf("level") == 14 then
				say(locale_quest(1349))
				say(locale_quest(1350))
			elseif d.getf("level") == 5 then
				say(locale_quest(1351))
				say(locale_quest(1352))
				d.notice(locale_quest(1351))
				d.notice(locale_quest(1352))
				d.kill_unique("door5")
				d.kill_unique("idoor5")
				d.setf("level", 15)
				d.set_regen_file("data/dungeon/flame_dungeon/fd_e.txt")
				local vis = { 0, 0, 0, 0, 0, 0, 0 }
				for i = 1, 7 do
					vis[i] = 0
				end

				for i = 1, 7 do
					local ran = number(1, 7)
					local st = 0
					for j = 1, 50 do
						st = st + 1
						if st > 7 then
							st = 1
						end
						if vis[st] == 0 then
							ran = ran - 1
							if ran == 0 then
								vis[st] = 1
								d.set_unique("stone5_"..st, d.spawn_mob(20386, setting.LEVEL5_STONE_POS[i][1], setting.LEVEL5_STONE_POS[i][2]))
								break
							end
						end
					end
				end
			elseif d.getf("level") == 15 then
				say(locale_quest(1353))
			elseif d.getf("level") == 6 then
				say(locale_quest(1354))
				d.notice(locale_quest(1354))
				d.setf("level", 16)
				d.kill_unique("door6")
				d.kill_unique("idoor6")
				d.set_regen_file("data/dungeon/flame_dungeon/fd_f.txt")
				d.spawn_mob(8057, setting.FLAME_DUNGEON_STONE_POS[1], setting.FLAME_DUNGEON_STONE_POS[2])
			elseif d.getf("level") == 16 then
				say(locale_quest(1355))
				say(locale_quest(1356))
			elseif d.getf("level") == 7 then
				--setskin(NOWINDOW)
				flame_dungeon.go_boss()
			else
				say(locale_quest(1357))
			end
			npc.unlock()
		end

		when dungeon_end_timer.server_timer begin
			local setting = flame_dungeon.setting()
			if d.select(get_server_timer_arg()) then
				flame_dungeon.clear_timer(d.get_map_index())
				d.set_warp_location(62, setting.outside_entry_pos[1], setting.outside_entry_pos[2])
				d.exit_all()
				d.setf("party_leader_pid", 0)
			end
		end

		when flame_count_monster.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.count_monster() <= 0 then
					if d.getf("level") == 11 then
						d.notice(locale_quest(1358))
						d.notice(locale_quest(1359))
					else
						d.notice(locale_quest(1358))
						d.notice(locale_quest(1359))
					end
					d.setf("level",0)
				else
					server_timer("killed_A_2", 6, get_server_timer_arg())
				end
			end
		end

		when killed_A_2.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.count_monster() <= 0 then
					if d.getf("level") == 11 then
						d.notice(locale_quest(1358))
						d.notice(locale_quest(1359))
					else
						d.notice(locale_quest(1358))
						d.notice(locale_quest(1359))
					end
					d.setf("level", 0)
				else
					server_timer("flame_count_monster", 6, get_server_timer_arg())
				end
			end
		end

		when kill with flame_dungeon.is_flamed(pc.get_map_index()) and d.getf("level") == 12 begin
			local setting = flame_dungeon.setting()
			local i = number(1, 100)
			if i == 1 then
				game.drop_item(setting.FLAME_DUNGEON_2F_ITEM_VNUM, 1)
			end
		end

		when 20386.take with flame_dungeon.is_flamed(pc.get_map_index()) and item.get_vnum() == flame_dungeon.setting().FLAME_DUNGEON_2F_ITEM_VNUM and d.getf("level") == 12 begin
			local i = number(1, 5)
			if i == 1 then
				npc.purge()
				item.remove()
				d.notice(locale_quest(1360))
				d.notice(locale_quest(1359))
				flame_dungeon.level_clear()
			else
				item.remove()
				say(locale_quest(1361))
			end
		end

		when 6051.kill with flame_dungeon.is_flamed(pc.get_map_index()) and d.getf("level") == 14 begin
			d.notice(locale_quest(1362))
			d.notice(locale_quest(1359))
			flame_dungeon.level_clear()
		end

		when kill with flame_dungeon.is_flamed(pc.get_map_index()) and d.getf("level") == 15 begin
			local setting = flame_dungeon.setting()
			local i = number(1, 30)
			if i == 1 then
				game.drop_item(setting.FLAME_DUNGEON_5F_ITEM_VNUM, 1)
			end
		end

		when 20386.take with flame_dungeon.is_flamed(d.get_map_index()) and item.get_vnum() == flame_dungeon.setting().FLAME_DUNGEON_5F_ITEM_VNUM and d.getf("level") == 15 begin
			local setting = flame_dungeon.setting()
			if npc.get_vid() == d.get_unique_vid("stone5_1") then
				npc.purge()
				item.remove()
				say(locale_quest(1363))
				d.setf("stonekill", 2)
				if d.count_monster() < 100 then
					d.regen_file("data/dungeon/flame_dungeon/fd_e.txt")
				end
			elseif npc.get_vid() == d.get_unique_vid("stone5_2") then
				if d.getf("stonekill") == 2 then
					npc.purge()
					item.remove()
					say(locale_quest(1364))
					d.setf("stonekill", 3)
					if d.count_monster() < 100 then
						d.regen_file("data/dungeon/flame_dungeon/fd_e.txt")
					end
				else
					item.remove()
					say(locale_quest(1365))
					if is_test_server() then
						say("2nd")
					end
				end
			elseif npc.get_vid() == d.get_unique_vid("stone5_3") then
				if d.getf("stonekill") == 3 then
					npc.purge()
					item.remove()
					say(locale_quest(1366))
					d.setf("stonekill", 4)
					if d.count_monster() < 100 then
						d.regen_file("data/dungeon/flame_dungeon/fd_e.txt")
					end
				else
					item.remove()
					say(locale_quest(1365))
					if is_test_server() then
						say("3th")
					end
				end
			elseif npc.get_vid() == d.get_unique_vid("stone5_4") then
				if d.getf("stonekill") == 4 then
					npc.purge()
					item.remove()
					say(locale_quest(1367))
					d.setf("stonekill", 5)
					if d.count_monster() < 100 then
						d.regen_file("data/dungeon/flame_dungeon/fd_e.txt")
					end
				else
					item.remove()
					say(locale_quest(1365))
					if is_test_server() then
						say("4th")
					end
				end
			elseif npc.get_vid() == d.get_unique_vid("stone5_5") then
				if d.getf("stonekill") == 5 then
					npc.purge()
					item.remove()
					say(locale_quest(1368))
					d.setf("stonekill", 6)
					if d.count_monster() < 100 then
						d.regen_file("data/dungeon/flame_dungeon/fd_e.txt")
					end
				else
					item.remove()
					say(locale_quest(1365))
					if is_test_server() then
						say("5th")
					end
				end
			elseif npc.get_vid() == d.get_unique_vid("stone5_6") then
				if d.getf("stonekill") == 6 then
					npc.purge()
					item.remove()
					say(locale_quest(1369))
					d.setf("stonekill", 7)
					if d.count_monster() < 100 then
						d.regen_file("data/dungeon/flame_dungeon/fd_e.txt")
					end
				else
					item.remove()
					say(locale_quest(1365))
					if is_test_server() then
						say("6th")
					end
				end
			else
				if d.getf("stonekill") == 7 then
					npc.purge()
					item.remove()
					d.notice(locale_quest(1360))
					d.notice(locale_quest(1359))
					flame_dungeon.level_clear()
				else
					item.remove()
					say(locale_quest(1365))
					if is_test_server() then
						say("7th")
					end
				end
			end
		end

		when 8057.kill with flame_dungeon.is_flamed(d.get_map_index()) and d.getf("level") == 16 begin
			d.notice(locale_quest(1370))
			d.notice(locale_quest(1359))
			flame_dungeon.level_clear()
		end

		when 6091.kill with flame_dungeon.is_flamed(d.get_map_index()) and d.getf("level") == 17 begin
			d.notice(locale_quest(1371))
			d.notice(locale_quest(1372))
			server_timer("dungeon_end_timer", 60, d.get_map_index())
			flame_dungeon.level_clear()

			if party.is_party() then
				party.setf("flame_dungeon_boss_kill_count", 1)
			end
		end
	end
end
